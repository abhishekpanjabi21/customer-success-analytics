	partition nps_responses = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "nps_responses.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"response_id", type text}, {"account_id", type text}, {"survey_date", type date}, {"nps_score", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

