	partition support_tickets = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "support_tickets.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"ticket_id", type text}, {"account_id", type text}, {"created_date", type date}, {"category", type text}, {"priority", type text}, {"resolution_hours", type number}, {"ticket_csat", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

