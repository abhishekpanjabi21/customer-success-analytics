		summarizeBy: none
		sourceColumn: features_adopted

		annotation SummarizationSetBy = User

	partition product_usage = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "product_usage.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"account_id", type text}, {"month", type date}, {"licensed_seats", Int64.Type}, {"active_users", Int64.Type}, {"logins", Int64.Type}, {"features_adopted", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

