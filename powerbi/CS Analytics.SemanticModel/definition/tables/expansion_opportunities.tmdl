				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"account_id", type text}, {"company_name", type text}, {"segment", type text}, {"plan", type text}, {"csm_owner", type text}, {"health_score", type number}, {"utilisation", type number}, {"avg_features", type number}, {"mrr_now", Int64.Type}, {"opportunity_type", type text}, {"potential_added_mrr", type number}}, "en-US")
