	partition onboarding = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "onboarding.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"account_id", type text}, {"kickoff_date", type date}, {"go_live_date", type date}, {"days_to_go_live", type number}, {"target_days", Int64.Type}, {"onboarding_status", type text}, {"training_sessions", Int64.Type}, {"onboarding_csat", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

