	partition accounts = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "accounts.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"account_id", type text}, {"company_name", type text}, {"industry", type text}, {"region", type text}, {"segment", type text}, {"plan", type text}, {"csm_owner", type text}, {"acquisition_channel", type text}, {"signup_date", type date}, {"renewal_date", type date}, {"status", type text}, {"churn_date", type date}, {"churn_reason", type text}, {"price_per_seat", Int64.Type}, {"contracted_seats_at_start", Int64.Type}}, "en-US")
				in
