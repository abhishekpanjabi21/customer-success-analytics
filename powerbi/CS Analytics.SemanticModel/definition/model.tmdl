model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder", "accounts", "monthly_revenue", "product_usage", "nps_responses", "onboarding", "support_tickets", "account_health", "expansion_opportunities"]

ref table accounts
ref table monthly_revenue
ref table product_usage
ref table nps_responses
ref table onboarding
ref table support_tickets
ref table account_health
ref table expansion_opportunities
ref table _Measures

